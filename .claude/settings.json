{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter pub outdated:*)",
      "Bash(flutter pub deps:*)",
      "Bash(flutter test:*)",
      "Bash(flutter doctor:*)",
      "Bash(flutter devices:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart fix --dry-run:*)",
      "Bash(dart run build_runner:*)",
      "Bash(dart run slang:*)",
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(flutter clean:*)",
      "Bash(flutter build:*)",
      "Bash(flutter pub upgrade:*)",
      "Bash(flutter pub add:*)",
      "Bash(dart fix --apply:*)",
      "Bash(shorebird:*)",
      "Bash(flutterfire:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-dart.ps1\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
