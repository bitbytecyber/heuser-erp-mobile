# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- heuser-erp-mobile additions -------------------------------------------
# Signing material and credentials never enter git.
android/key*.properties
android/app/*.jks
android/app/*.keystore
*.p8
*.p12
*.mobileprovision
/appcredentials/
# Firebase config is per-flavor and committed; the service-account JSON is not.
**/service-account*.json
# Codegen outputs ARE committed (CI checks they are fresh). Coverage is not.
coverage/
# Golden failure artefacts.
**/failures/
# Local env overrides.
env/*.local.json
.env*.local
