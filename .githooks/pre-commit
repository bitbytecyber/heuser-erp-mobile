#!/bin/sh
# Local gate, mirroring codemagic.yaml's analyze-and-test workflow:
# format (staged files) → analyze (fatal infos/warnings) → tests.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# Escape hatches, in order of preference:
#   SKIP_TESTS=1 git commit ...    format + analyze only
#   git commit --no-verify ...     nothing at all (say why in the message)
#
# Skipped entirely when the commit touches no Dart code and no pubspec, so
# docs-only commits stay instant.

if ! command -v flutter >/dev/null 2>&1; then
  for candidate in "$HOME/fvm/default/bin" "$HOME/development/flutter/bin" \
                   "$HOME/flutter/bin" "/opt/homebrew/bin" "/usr/local/bin" \
                   "/c/flutter/bin" "/d/flutter/bin"; do
    if [ -x "$candidate/flutter" ]; then PATH="$candidate:$PATH"; export PATH; break; fi
  done
fi
if ! command -v flutter >/dev/null 2>&1; then
  echo "pre-commit: cannot find 'flutter' on PATH (add the SDK bin dir, or --no-verify)."
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACM)
staged_dart=$(printf '%s\n' "$staged" | grep -E '\.dart$' | grep -vE '\.(g|freezed|config)\.dart$|strings\.g\.dart$')
touches_code=$(printf '%s\n' "$staged" | grep -E '\.dart$|pubspec\.(yaml|lock)$|\.i18n\.json$')
[ -z "$touches_code" ] && exit 0

# --- native lock drift: pubspec.lock and ios/Podfile.lock move together -----
if printf '%s\n' "$staged" | grep -qE '^pubspec\.lock$'; then
  if [ -f ios/Podfile.lock ] && ! printf '%s\n' "$staged" | grep -qE '^ios/Podfile\.lock$'; then
    echo "pre-commit: pubspec.lock is staged but ios/Podfile.lock is not."
    echo "  Run (cd ios && pod install) on a Mac and stage ios/Podfile.lock,"
    echo "  or --no-verify if the pods are genuinely unchanged."
    exit 1
  fi
fi

# --- file-size rule: every hand-written Dart file stays under 300 lines ------
too_long=""
for f in $staged_dart; do
  [ -f "$f" ] || continue
  n=$(wc -l < "$f")
  [ "$n" -gt 300 ] && too_long="$too_long\n  $f ($n lines)"
done
if [ -n "$too_long" ]; then
  printf 'pre-commit: files over 300 lines (split them, see .claude/rules/architecture-rules.md):%b\n' "$too_long"
  exit 1
fi

# --- format (staged files only) ---------------------------------------------
if [ -n "$staged_dart" ]; then
  echo "pre-commit: dart format"
  if ! printf '%s\n' "$staged_dart" | xargs dart format --output=none --set-exit-if-changed; then
    echo "Fix with: dart format $(printf '%s ' $staged_dart)"
    exit 1
  fi
fi

if ! git diff --quiet; then
  echo "pre-commit: note - unstaged changes present; analyze and test see them too"
fi

# --- analyze (same flags as CI) ---------------------------------------------
echo "pre-commit: flutter analyze"
if ! flutter analyze --fatal-infos --fatal-warnings; then
  echo "flutter analyze found issues. Commit blocked."
  exit 1
fi

# --- test -------------------------------------------------------------------
if [ -n "$SKIP_TESTS" ]; then
  echo "pre-commit: SKIP_TESTS set - skipping flutter test"
  exit 0
fi
echo "pre-commit: flutter test (SKIP_TESTS=1 to skip)"
if ! flutter test; then
  echo "flutter test failed. Commit blocked."
  exit 1
fi
if printf '%s\n' "$staged" | grep -q '^packages/heuser_ds/'; then
  echo "pre-commit: heuser_ds tests"
  (cd packages/heuser_ds && flutter test) || { echo "heuser_ds tests failed. Commit blocked."; exit 1; }
fi
exit 0
